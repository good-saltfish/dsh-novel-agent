{
  "name": "dsh-novel-agent",
  "version": "0.2.2",
  "description": "DSH 右侧栏小说工作台：托管本地 ndecon 引擎，把「新建项目 → 生成骨架 → 看上下文包 → 生成一章 → 过硬门 → 连写续跑」搬进右栏。A DSH right-sidebar novel studio that hosts the local ndecon engine and exposes project, context-pack, chapter, and gate surfaces.",
  "type": "module",
  "main": "./lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.2"
  },
  "scripts": {
    "test": "node test/all.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/good-saltfish/dsh-novel-agent.git"
  },
  "homepage": "https://github.com/good-saltfish/dsh-novel-agent#readme",
  "bugs": {
    "url": "https://github.com/good-saltfish/dsh-novel-agent/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "novel",
    "writing",
    "sidebar",
    "webnovel",
    "chinese"
  ]
}
